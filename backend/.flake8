[flake8]
max-line-length = 99
# E203: whitespace before ':' (conflicts with Black)
# W503: line break before binary operator (conflicts with Black)
# E266: too many leading '#' for block comment
# E501: line too long (handled by Black)
# W391: blank line at end of file
ignore = E203,W503,E266,E501,W391
exclude = 
    .git,
    __pycache__,
    venv,
    env,
    .venv,
    .env,
    build,
    dist,
    migrations,
    .pytest_cache,
    .mypy_cache,
    htmlcov,
    .coverage
per-file-ignores =
    # Imported but unused
    __init__.py: F401
    # Import not at top of file
    app/extensions.py: E402
    # Line too long in tests
    tests/*: E501
EOF < /dev/null