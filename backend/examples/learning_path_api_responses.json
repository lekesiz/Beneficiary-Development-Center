  "frontend_integration": {
    "component_flow": [
      {
        "step": 1,
        "component": "StudentProfile.tsx",
        "action": "Koç, öğrenci profilinde 'Öğrenme Yolu' sekmesine tıklar"
      },
      {
        "step": 2,
        "component": "LearningPathUpdatesSection.tsx",
        "action": "Aktif öğrenme yolları listelenir, koç birini seçer"
      },
      {
        "step": 3,
        "action": "Koç 'Önerileri Güncelle' butonuna tıklar",
        "api_call": "POST /api/learning-paths/students/{student_id}/suggest-updates",
        "result": "AI analizi yapılır ve yeni öneriler oluşturulur"
      },
      {
        "step": 4,
        "component": "LearningPathUpdatesSection.tsx",
        "action": "Bekleyen güncellemeler öncelik sırasına göre gösterilir"
      },
      {
        "step": 5,
        "action": "Koç her güncelleme için:",
        "options": [
          "✅ Onayla - Güncelleme onaylanır",
          "❌ Reddet - Sebep belirtilerek reddedilir",
          "🚀 Uygula - Onaylı güncelleme öğrenme yoluna eklenir"
        ]
      }
    ],
    "ui_states": {
      "loading": "Spinner gösterilir",
      "empty": "Bekleyen güncelleme yok mesajı",
      "error": "Hata mesajı ve yeniden deneme butonu",
      "success": "Başarı bildirimi (toast)",
      "reject_modal": "Reddetme sebebi için modal dialog"
    }
  },
  "webhook_events": {
    "learning_path_update_suggested": {
      "description": "Yeni güncelleme önerisi oluşturulduğunda",
      "payload": {
        "event": "learning_path_update_suggested",
        "student_id": 123,
        "learning_path_id": 789,
        "update_id": 456,
        "priority": "critical",
        "strategy": "crisis_intervention"
      }
    },
    "learning_path_update_approved": {
      "description": "Güncelleme onaylandığında",
      "payload": {
        "event": "learning_path_update_approved",
        "update_id": 456,
        "approved_by": 10,
        "learning_path_id": 789
      }
    },
    "learning_path_update_applied": {
      "description": "Güncelleme uygulandığında",
      "payload": {
        "event": "learning_path_update_applied",
        "update_id": 456,
        "learning_path_id": 789,
        "milestones_added": 3,
        "student_id": 123
      }
    }
  }
}