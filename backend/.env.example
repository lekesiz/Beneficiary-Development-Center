# Flask Configuration
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database Configuration
DATABASE_URL=postgresql://bdc_user:bdc_password@localhost:5432/bdc_db
# For development, you can use SQLite:
# DATABASE_URL=sqlite:///bdc.db

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=3600  # 1 hour in seconds
JWT_REFRESH_TOKEN_EXPIRES=2592000  # 30 days in seconds

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_URL=redis://localhost:6379/1

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_ORGANIZATION=your-openai-org-id  # Optional

# OpenAI Model Settings
OPENAI_MODEL=gpt-4  # Options: gpt-4, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000  # Maximum tokens in response
OPENAI_TEMPERATURE=0.7  # 0-2, higher values = more creative
OPENAI_TOP_P=1.0  # 0-1, alternative to temperature
OPENAI_FREQUENCY_PENALTY=0.0  # -2.0 to 2.0
OPENAI_PRESENCE_PENALTY=0.0  # -2.0 to 2.0

# OpenAI API Settings
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_TIMEOUT=30  # Timeout in seconds
OPENAI_API_VERSION=v1

# OpenAI Assistant Configuration (Optional)
OPENAI_ASSISTANT_ID=your-assistant-id-here
OPENAI_ASSISTANT_THREAD_ID=your-thread-id-here

# Fine-tuning Configuration (Optional)
OPENAI_FINE_TUNED_MODEL=your-fine-tuned-model-id

# Rate Limiting
OPENAI_RATE_LIMIT_RPM=60  # Requests per minute
OPENAI_RATE_LIMIT_TPM=150000  # Tokens per minute
OPENAI_RETRY_ATTEMPTS=3
OPENAI_RETRY_DELAY=1  # Delay between retries in seconds

# OpenAI Embedding Settings
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_EMBEDDING_BATCH_SIZE=100

# OpenAI Moderation (Optional)
OPENAI_MODERATION_ENABLED=False
OPENAI_MODERATION_MODEL=text-moderation-latest

# Logging and Debugging
OPENAI_LOG_REQUESTS=False
OPENAI_LOG_RESPONSES=False
OPENAI_DEBUG_MODE=False

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=noreply@bdc.com

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# File Upload
MAX_CONTENT_LENGTH=16777216  # 16MB
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=pdf,doc,docx,jpg,jpeg,png,gif

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=bdc.log

# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn

# API Rate Limiting
RATELIMIT_STORAGE_URL=redis://localhost:6379/4

# Multi-tenant Configuration
TENANT_HEADER=X-Tenant-ID
DEFAULT_TENANT_ID=1

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Frontend URL
FRONTEND_URL=http://localhost:3000