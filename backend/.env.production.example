# Production Environment Configuration for BDC Platform

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# Security Keys (Generate new ones for production!)
SECRET_KEY=your-very-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# Database Configuration
# For Google Cloud SQL: postgresql://username:password@/database?host=/cloudsql/INSTANCE_CONNECTION_NAME
# For external PostgreSQL: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://bdc_user:bdc_password@localhost:5432/bdc_db

# Redis Configuration (optional, will fallback to in-memory if not available)
REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_URL=redis://localhost:6379/1

# CORS Configuration
CORS_ORIGINS=https://your-frontend-domain.com

# Frontend URL
FRONTEND_URL=https://your-frontend-domain.com

# Email Configuration (optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# OpenAI Configuration (optional, for AI features)
OPENAI_API_KEY=your-openai-api-key

# JWT Token Expiration (in seconds)
JWT_ACCESS_TOKEN_EXPIRES=86400  # 24 hours
JWT_REFRESH_TOKEN_EXPIRES=2592000  # 30 days

# File Upload Settings
MAX_CONTENT_LENGTH=16777216  # 16MB
UPLOAD_FOLDER=uploads

# Rate Limiting
RATELIMIT_STORAGE_URL=redis://localhost:6379/4

# Logging
LOG_LEVEL=INFO
LOG_FILE=bdc_production.log

# Multi-tenant Settings
DEFAULT_TENANT_ID=1
TENANT_HEADER=X-Tenant-ID